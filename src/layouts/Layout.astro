---
import Facebook from "@components/assets/icons/facebook.astro";
import Instagram from "@components/assets/icons/Instagram.astro";
import Thread from "@components/assets/icons/thread.astro";
import Tiktok from "@components/assets/icons/tiktok.astro";
import Button from "@components/Button";
import Nav from "@components/Nav";
import { ViewTransitions } from "astro:transitions";
import { FaThreads } from "react-icons/fa6";
import { FaTiktok } from "react-icons/fa6";
import { FaInstagram } from "react-icons/fa6";
import { FaFacebookF } from "react-icons/fa6";
import Dock from "@components/Dock.astro";
interface Props {
  title: string;
}

const { title } = Astro.props;

let LINK = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Ginecoobstetra vanguardista, experta en salud sexual, reproductiva,colposcopia,patología vulvar y trastornos hormonales con 15 años de experiencia."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="canonical" href="https://cesiaborjon.com/" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta
      name="keywords"
      content="Ginecologa tijuana zona rio, Ginecologa tijuana precios, Los mejores ginecólogos en Tijuana, Atencion ginecologica  "
    />
    <meta name="author" content="Doctora Cesia Borjón" />
    <meta name="publisher" content="Ecommetrica" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cesiaborjon.com/" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Ginecoobstetra vanguardista, experta en salud sexual, reproductiva,colposcopia,patología vulvar y trastornos hormonales con 15 años de experiencia."
    />
    <meta
      property="og:image"
      content="https://cesiaborjon.com/FotoCesiaLink.webp"
    />
    <ViewTransitions />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3V7EN3MFR9"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-3V7EN3MFR9");
    </script>
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-WR3MVSWK");
    </script>
    <script type="text/partytown">
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };

        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";

        n.queue = [];
        t = b.createElement(e);
        t.async = !0;

        t.src = v;
        s = b.getElementsByTagName(e)[0];

        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",

        "https://connect.facebook.net/en_US/fbevents.js"
      );

      fbq("init", "1069153451294599");

      fbq("track", "PageView");
    </script>
  </head>
  <body class="overflow-x-hidden">
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WR3MVSWK"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=1069153451294599&ev=PageView&noscript=1"
      /></noscript
    >
    <Nav URL={LINK} client:load />
    <slot />
    <Dock />
  </body>{
    (
      <footer class="md:h-[550px] bg-[#B09FCD] text-white px-8 py-16 md:w-[100%] mx-auto">
        <img
          src="/Ginecologa feminista certificada en Tijuana.png"
          class="absolute left-0 z-0"
          title="Acude a consulta ginecologica feminista certificada en Tijuana "
          alt="Acude a consulta ginecologica feminista certificada en Tijuana "
        />
        <img
          src="/Ginecologa feminista certificada en Tijuana.png"
          class="absolute right-0 z-0 rotate-180"
          alt="Acude a consulta ginecologica feminista certificada en Tijuana "
          title="Acude a consulta ginecologica feminista certificada en Tijuana "
        />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 z-10 relative">
          <div class="text-start">
            <h1 class="text-[30px] font-bold mb-8">UBICACIÓN</h1>
            <iframe
              title="Ubicación de la clínica de la Dra. Cesia Borjón"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d594.6340972315487!2d-117.01575147650581!3d32.53259852457227!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80d94958944d9c67%3A0x1d12fba54673ee22!2sTorre%20Norte%202!5e0!3m2!1ses!2smx!4v1722620687129!5m2!1ses!2smx"
              allowfullscreen=""
              class="w-full h-[300px] md:h-[300px]"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          </div>
          <div>
            <h1 class="text-[30px] font-bold mb-8">LOCALÍZAME</h1>
            <p class="mb-8">Torre Norte No. 2, Piso 8, Local: 809 y 810.</p>
            <p class="mb-8">Calle: Fray Servando Teresa de Mier, #1351.</p>

            <p class="mb-8">Zona Urbana Río Tijuana, C.P. 22010</p>
            <p class="mb-8">Tijuana, Baja California, México.</p>
          </div>

          <div>
            <h1 class="text-[30px] font-bold mb-8">CONTÁCTAME</h1>
            <p class="mb-6">Doctora Cesia Borjón</p>

            <p class="mb-6">
              <Button
                client:visible
                eventName="email_click"
                category="Boton"
                label="Email"
                onClick={() => {}}
                href="mailto:doctora@cesiaborjon.com"
                className="hover:underline"
              >
                doctora@cesiaborjon.com
              </Button>
            </p>

            <p class="mb-6">
              <Button
                client:visible
                eventName="phone_click"
                category="Boton"
                label="Teléfono"
                onClick={() => {}}
                href="tel:6649763510"
                className="hover:underline"
              >
                664 976 3510
              </Button>
            </p>
            <p class="mb-8">
              <Button
                client:visible
                eventName="website_click"
                category="Boton"
                label="Sitio Web"
                onClick={() => {}}
                href="/"
                className="mb-6 hover:underline"
              >
                cesiaborjon.com
              </Button>
            </p>

            <Button
              client:visible
              eventName="contact_click"
              category="Boton"
              label="Contacto"
              onClick={() => {}}
              href="/contacto/"
              className="bg-[#FABB70] font-binomaBold font-bold rounded-full text-black px-8 py-4"
            >
              ¡CONTÁCTAME!
            </Button>
          </div>

          <div class="hidden md:block">
            <h1 class="text-[30px] font-bold mb-8">SÍGUEME</h1>
            <div class="flex gap-4">
              <Button
                client:visible
                eventName="instagram_click"
                category="Boton"
                label="Instagram"
                onClick={() => {}}
                target="_blank"
                href="https://www.instagram.com/dracesiaborjonginecologa/"
              >
                <Instagram class="cursor-pointer fill-white" />
              </Button>
              <Button
                client:visible
                eventName="facebook_click"
                category="Boton"
                label="Facebook"
                onClick={() => {}}
                target="_blank"
                href="https://www.facebook.com/ginecologahermosillo/"
              >
                <Facebook class="cursor-pointer fill-white" />
              </Button>
              <Button
                client:visible
                eventName="tiktok_click"
                category="Boton"
                label="Tiktok"
                onClick={() => {}}
                target="_blank"
                href="https://www.tiktok.com/@ginecesiaborjon"
              >
                <Tiktok class="cursor-pointer fill-white" />
              </Button>
              <Button
                client:visible
                eventName="threads_click"
                category="Boton"
                label="Threads"
                onClick={() => {}}
                target="_blank"
                href="https://www.threads.net/@dracesiaborjonginecologa?xmt=AQGzDYoTSWZoqF1UnIXONVmb_6WfKrrWDU9QEumtdr-rddY"
              >
                <Thread class="cursor-pointer fill-white" />
              </Button>
            </div>
            <p class="mb-6 mt-6">
              Registro Profesional Estatal Médico Cirujano y Partero
              031572-02/24
            </p>
            <p class="mb-6">
              Registro Profesional Estatal Especialidad en Ginecología y
              Obstetricia 031573-02/24
            </p>
            <p>Aviso COFEPRIS 2302022002A00068</p>
          </div>
          <div class="block md:hidden">
            <h1 class="text-[30px] font-bold mb-8">SÍGUEME</h1>
            <div class="flex gap-4">
              <Button
                client:visible
                eventName="instagram_click"
                category="Boton"
                label="Instagram"
                target="_blank"
                href="https://www.instagram.com/dracesiaborjonginecologa/"
                onClick={() => {}}
              >
                <FaInstagram className="text-5xl text-black bg-white rounded-full border-[3px] p-2 border-black" />
              </Button>
              <Button
                client:visible
                eventName="facebook_click"
                category="Boton"
                label="Facebook"
                onClick={() => {}}
                target="_blank"
                href="https://www.facebook.com/ginecologahermosillo/"
              >
                <FaFacebookF className="text-5xl text-black bg-white rounded-full border-[3px] p-2 border-black" />
              </Button>
              <Button
                client:visible
                eventName="tiktok_click"
                category="Boton"
                label="Tiktok"
                onClick={() => {}}
                target="_blank"
                href="https://www.tiktok.com/@draborjongine"
              >
                <FaTiktok className="text-5xl text-black bg-white rounded-full border-[3px] p-2 border-black" />
              </Button>
              <Button
                client:visible
                eventName="threads_click"
                category="Boton"
                label="Threads"
                onClick={() => {}}
                target="_blank"
                href="https://www.threads.net/@dracesiaborjonginecologa?xmt=AQGzDYoTSWZoqF1UnIXONVmb_6WfKrrWDU9QEumtdr-rddY"
              >
                <FaThreads className="text-5xl text-black bg-white rounded-full border-[3px] p-2 border-black" />
              </Button>
            </div>
            <p class="mb-6 mt-6">
              Registro Profesional Estatal Médico Cirujano y Partero
              031572-02/24
            </p>
            <p class="mb-6">
              Registro Profesional Estatal Especialidad en Ginecología y
              Obstetricia 031573-02/24
            </p>
            <p class="mb-8">Aviso COFEPRIS 2302022002A00068</p>
          </div>
        </div>
      </footer>
    )
  }
</html>

<style is:global>
  html {
    background-color: white;
  }

  @font-face {
    font-family: "Glorich";
    src: url("/fonts/Glorich-Regular.otf") format("opentype");
    font-weight: 400;
    font-style: normal;
  }

  @font-face {
    font-family: "Glorich";
    src: url("/fonts/Glorich-Medium.otf") format("opentype");
    font-weight: 500;
    font-style: normal;
  }

  @font-face {
    font-family: "Glorich";
    src: url("/fonts/Glorich-SemiBold.otf") format("opentype");
    font-weight: 600;
    font-style: normal;
  }

  @font-face {
    font-family: "Glorich";
    src: url("/fonts/Glorich-Bold.otf") format("opentype");
    font-weight: 700;
    font-style: normal;
  }

  @font-face {
    font-family: "Glorich";
    src: url("/fonts/Glorich-ExtraBold.otf") format("opentype");
    font-weight: 800;
    font-style: normal;
  }

  @font-face {
    font-family: "BinomaBold";
    src: url("/fonts/BinomaTrialBold-1jPDj.ttf") format("truetype");
    font-weight: bold;
    font-style: normal;
  }

  @font-face {
    font-family: "BinomaRegular";
    src: url("/fonts/BinomaTrialRegular-R9Kvv.ttf") format("truetype");
    font-weight: normal;
    font-style: normal;
  }

  @font-face {
    font-family: "Blisstwin";
    src: url("/fonts/blisstwin.otf") format("opentype");
    font-weight: normal;
    font-style: normal;
  }

  html {
    scroll-behavior: smooth;
  }
</style>
