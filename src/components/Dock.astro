---
import { FaThreads, FaTiktok, FaInstagram, FaFacebookF } from "react-icons/fa6";

const socialLinks = [
  {
    name: "Instagram",
    url: "https://www.instagram.com/dracesiaborjonginecologa/",
    icon: "instagram",
    color: "from-purple-600 via-pink-600 to-orange-500",
    shadowColor: "shadow-pink-500/25",
  },
  {
    name: "Facebook",
    url: "https://www.facebook.com/ginecologahermosillo/",
    icon: "facebook",
    color: "from-blue-600 to-blue-700",
    shadowColor: "shadow-blue-500/25",
  },
  {
    name: "TikTok",
    url: "https://www.tiktok.com/@draborjongine",
    icon: "tiktok",
    color: "from-black via-gray-900 to-black",
    shadowColor: "shadow-gray-800/25",
  },
  {
    name: "Threads",
    url: "https://www.threads.net/@dracesiaborjonginecologa?xmt=AQGzDYoTSWZoqF1UnIXONVmb_6WfKrrWDU9QEumtdr-rddY",
    icon: "threads",
    color: "from-gray-900 via-black to-gray-800",
    shadowColor: "shadow-gray-700/25",
  },
];
---

<div
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 md:hidden [&.overflow-hidden]:hidden"
>
  <div
    class="flex gap-3 px-4 py-3 rounded-2xl shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)] border border-white/20 backdrop-blur-2xl bg-white/10 relative overflow-hidden"
  >
    <!-- Animated background glow -->
    <div
      class="absolute inset-0 animate-pulse bg-gradient-to-r from-purple-500/10 via-pink-500/10 to-orange-400/10 pointer-events-none"
    ></div>

    {socialLinks.map((social) => (
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        class={`relative flex items-center justify-center p-3 rounded-xl bg-gradient-to-br ${social.color} ${social.shadowColor} transition-transform duration-300 hover:scale-125`}
      >
        <div
          class={`absolute inset-0 rounded-xl opacity-0 transition-opacity duration-300 blur hover:opacity-100 bg-gradient-to-br ${social.color}`}
        ></div>

        {social.icon === "instagram" && (
          <FaInstagram className="relative z-10 text-xl text-white" />
        )}
        {social.icon === "facebook" && (
          <FaFacebookF className="relative z-10 text-xl text-white" />
        )}
        {social.icon === "tiktok" && (
          <FaTiktok className="relative z-10 text-xl text-white" />
        )}
        {social.icon === "threads" && (
          <FaThreads className="relative z-10 text-xl text-white" />
        )}

        <!-- Tooltip -->
        <div
          class="absolute top-[-3rem] left-1/2 -translate-x-1/2 translate-y-2 opacity-0 pointer-events-none whitespace-nowrap text-white text-xs px-2 py-1 rounded-md bg-black/80 backdrop-blur-sm transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0"
        >
          {social.name}
          <div class="absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-l-transparent border-r-transparent border-t-black/80"></div>
        </div>
      </a>
    ))}
  </div>
</div>
