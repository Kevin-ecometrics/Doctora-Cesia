---
import Arrow from "@components/cirugias/Arrow";
import CirugiasList from "@components/cirugias/CirugiasList";

const URL = Astro.url.pathname;

const filteredCirugias = CirugiasList.filter((cirugia) => cirugia.url !== URL);
---

<main class="p-8 bg-[#7DCAD9]">
  <div class="mx-auto container space-y-8 gap-8 text-white">
    <!-- <header class="text-center space-y-8 mb-8 md:mb-16">
      <h1 class="text-4xl md:text-5xl font-bold">
        Cirugías especializadas para tu bienestar y salud integral
      </h1>
      <p class="text-lg md:text-xl font-light text-white/90">
        Explora los procedimientos quirúrgicos diseñados para atender tus
        necesidades de salud con precisión, seguridad y el respaldo de la Dra.
        Cesia Borjon.
      </p>
    </header> -->
    {
      filteredCirugias.map((cirugia) => (
        <article class="grid-cols-1 grid md:grid-cols-2 gap-4 items-start">
          <div class="col-span-1 relative group md:hidden block">
            <img
              src={cirugia.img}
              loading="lazy"
              alt={cirugia.title}
              title={cirugia.title}
              class="rounded-lg object-cover"
            />
            <div class="absolute bottom-2 left-2 md:bottom-10 md:-left-10 overflow-hidden rounded-full bg-[#B09FCD]">
              <Arrow client:visible title={cirugia.title} URL={cirugia.url} />
            </div>
          </div>{" "}
          <div class="col-span-1 space-y-4 ">
            <a href={cirugia.url}>
              <h2 class="text-3xl md:text-5xl font-bold hover:text-[#B09FCD] transition-colors duration-300 cursor-pointer">
                {cirugia.title}
              </h2>
            </a>

            <p class="text-lg md:text-xl font-light text-white/90 leading-relaxed">
              {cirugia.subtitle}
            </p>

            <div class="flex items-center space-x-4 pt-2">
              <span class="w-16 h-px bg-white/50" />
              <span class="text-2xl md:text-3xl font-bold tracking-wide">
                {cirugia.year}
              </span>
            </div>
          </div>
          <figure class="col-span-1 relative group md:block hidden">
            <img
              src={cirugia.img}
              loading="lazy"
              alt={cirugia.title}
              title={cirugia.title}
              class="rounded-lg object-cover"
            />

            <div class="absolute bottom-2 left-2 md:bottom-10 md:-left-10 overflow-hidden bg-[#B09FCD] rounded-full">
              <Arrow client:visible title={cirugia.title} URL={cirugia.url} />
            </div>
          </figure>
        </article>
      ))
    }
  </div>
</main>
