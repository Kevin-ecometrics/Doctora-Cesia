---
import {
  FaFacebook,
  FaFacebookF,
  FaInstagram,
  FaThreads,
  FaTiktok,
} from "react-icons/fa6";
import "./Scroll.css";
interface Props {
  title: string;
  description: string;
  blogtext: string;
}
const { title, description, blogtext } = Astro.props;
---

<main class="grid grid-cols-1 md:grid-cols-3 gap-4 p-4 mx-auto container">
  <div class="col-span-2 relative">
    <h1 class="font-blisstwine text-[66px]">
      {title}
    </h1>
    <p class="text-[18px] font-binomaRegular mb-8">
      {description}
    </p>
    <div class="absolute bottom-0">
      <span class="text-gray-500 text-2xl">
        Síguenos en nuestras redes sociales:
      </span>
      <div class="flex gap-4 mt-4 mb-8">
        <a
          href="https://www.instagram.com/dracesiaborjonginecologa/"
          target="_blank"
          class="text-pink-500 hover:text-pink-700 text-4xl"
        >
          <FaInstagram />
        </a>
        <a
          href="https://www.facebook.com/ginecologahermosillo/"
          target="_blank"
          class="text-blue-500 hover:text-blue-700 text-4xl"
        >
          <FaFacebook />
        </a>
        <a
          href="https://www.tiktok.com/@ginecesiaborjon"
          target="_blank"
          class="text-black hover:text-gray-700 text-4xl"
        >
          <FaTiktok />
        </a>
        <a
          href="https://www.threads.com/@dracesiaborjonginecologa?xmt=AQGzDYoTSWZoqF1UnIXONVmb_6WfKrrWDU9QEumtdr-rddY"
          target="_blank"
          class="text-gray-500 hover:text-gray-700 text-4xl"
        >
          <FaThreads />
        </a>
      </div>
    </div>
  </div>
  <div
    class="overflow-y-auto text-balance max-h-[600px] pl-4 scrollbar-left"
    set:html={blogtext}
  />
</main>
